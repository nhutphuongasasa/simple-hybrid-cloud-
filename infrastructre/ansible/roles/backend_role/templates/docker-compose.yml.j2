version: '3.8'

services:
  backend:
    image: {{ backend_image }}
    environment:
      DB_HOST: {{ DB_HOST}}
      DB_PORT: {{ DB_PORT }}
      DB_USERNAME: {{ DB_USERNAME }}
      DB_PASSWORD: {{ DB_PASSWORD }}
      DB_DATABASE: {{ DB_DATABASE }}
    ports:
      - "{{ backend_port }}:{{ backend_port }}"
    restart: unless-stopped